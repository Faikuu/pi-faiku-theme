{
  "name": "@faiku/pi-faiku-theme",
  "version": "0.1.0",
  "description": "Pi theme and ASCII input box in opencode's default style, with top-right copy/paste toasts",
  "author": "Faiku",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "pi",
    "theme",
    "tui",
    "opencode",
    "ascii",
    "emoji"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faikuu/FaikuTheme.git"
  },
  "homepage": "https://github.com/Faikuu/FaikuTheme#readme",
  "bugs": {
    "url": "https://github.com/Faikuu/FaikuTheme/issues"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "themes": ["./themes/*.json"]
  },
  "files": [
    "index.ts",
    "lib/",
    "themes/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
